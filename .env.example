# Local development environment (issue #3).
#
#   cp .env.example .env
#   docker compose up --build
#
# Then http://localhost:8080 serves the API and the Angular frontend from the
# same origin. This file's values are for a throwaway local database/object
# store only — never reuse any of them anywhere real, and never commit the
# filled-in `.env` (it is git-ignored).

ASPNETCORE_ENVIRONMENT=Development

# SQL Server. Developer edition is free for dev/test use and has no feature
# limits to trip over locally (production uses Express — see
# infra/compose/.env.example).
MSSQL_SA_PASSWORD=Dev_Password123!
MSSQL_PID=Developer
# Least-privilege application/migrator logins created by sqlserver-init.sh —
# the API authenticates as MSSQL_APP_PASSWORD's login (db_datareader/
# db_datawriter only), never as sa. MSSQL_MIGRATOR_PASSWORD's login is
# db_owner, used only by the transient `migrator` container.
MSSQL_APP_PASSWORD=Dev_AppPassword123!
MSSQL_MIGRATOR_PASSWORD=Dev_MigratorPassword123!

# MinIO — same image/bootstrap flow as production (issue #11), just with
# throwaway local credentials.
MINIO_ROOT_USER=nimbus-dev-root
MINIO_ROOT_PASSWORD=Dev_MinioRoot123!
# Dedicated application key, scoped by minio-init.sh to only
# flight-images/flight-tracks/flight-exports/map-cache, no admin rights —
# this is what the API authenticates with, never MINIO_ROOT_*.
MINIO_APP_ACCESS_KEY=nimbus-dev-app
MINIO_APP_SECRET_KEY=Dev_MinioApp123!
