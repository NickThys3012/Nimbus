{
  "name": "nimbus.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "curl -sf http://localhost:5214/openapi/v1.json -o .openapi-spec.json && openapi --input .openapi-spec.json --output src/app/core/api-client --client angular --useOptions --name NimbusApiClient && rm -f .openapi-spec.json",
    "lint": "ng lint",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@tabler/icons-webfont": "^3.46.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.1.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ttf2woff2@8.0.1": true,
    "msgpackr-extract@3.0.4": true,
    "lmdb@3.5.6": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
