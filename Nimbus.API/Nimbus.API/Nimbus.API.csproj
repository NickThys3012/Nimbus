<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <UserSecretsId>2645fa16-ff7c-4485-a201-da3aa07b5842</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.17"/>
        <!-- Trajectory/PDF map rendering (issues #57, #62) needs SkiaSharp at runtime.
             Brought in now (issue #96) so the production image's native dependencies
             are proven before any feature code depends on them. The `.NoDependencies`
             native asset statically links freetype/fontconfig/harfbuzz instead of
             dynamically linking the host's — the dynamic variant hits undefined-symbol
             failures against Ubuntu 24.04's fontconfig/libuuid ABI (verified against the
             `mcr.microsoft.com/dotnet/aspnet:10.0` image while building this image). -->
        <PackageReference Include="SkiaSharp" Version="3.119.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nimbus.Application\Nimbus.Application.csproj"/>
        <ProjectReference Include="..\Nimbus.Infrastructure\Nimbus.Infrastructure.csproj"/>
        <ProjectReference Include="..\Nimbus.Logging\Nimbus.Logging.csproj"/>
        <ProjectReference Include="..\Nimbus.Observability\Nimbus.Observability.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <SpaRoot>..\..\Nimbus.Web\</SpaRoot>
        <SpaDist>$(SpaRoot)dist\nimbus\browser\</SpaDist>
    </PropertyGroup>

    <Target Name="PublishAngular" AfterTargets="ComputeFilesToPublish"
            Condition="'$(SkipSpaBuild)' != 'true'">
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production" />
        <ItemGroup>
            <SpaFiles Include="$(SpaDist)**\*" />
            <ResolvedFileToPublish Include="@(SpaFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
