{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "WebBaseUrl": ""
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "FromAddress": "noreply@send.nickthys.be",
    "FromName": "Nimbus",
    "ReplyToAddress": "nick.thijs@hotmail.com",
    "MaxAttempts": 3,
    "RetryBaseDelayMs": 500,
    "TimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "AllowedHosts": "*",
  "Loki": {
    "Url": "",
    "Environment": "production"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Nimbus.Server",
    "Audience": "Nimbus.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenSessionHours": 12
  },
  "AviationWeather": {
    "BaseUrl": "https://aviationweather.gov/api/data/",
    "TimeoutSeconds": 8,
    "UserAgent": "Nimbus/1.0 (flight preparation)",
    "Resilience": { "MaxRetries": 2, "RetryBaseDelayMs": 300, "BreakAfterFailures": 5, "BreakDurationSeconds": 30, "SamplingSeconds": 30 }
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com/v1/",
    "TimeoutSeconds": 10,
    "UserAgent": "Nimbus/1.0 (flight preparation)",
    "ForecastModel": "icon_seamless",
    "ForecastDays": 3,
    "SeriesCacheMinutes": 60,
    "Resilience": { "MaxRetries": 2, "RetryBaseDelayMs": 300, "BreakAfterFailures": 5, "BreakDurationSeconds": 30, "SamplingSeconds": 30 }
  },
  "Overpass": {
    "BaseUrl": "https://overpass-api.de/api/",
    "TimeoutSeconds": 25,
    "UserAgent": "Nimbus/1.0 (flight preparation)",
    "Resilience": { "MaxRetries": 2, "RetryBaseDelayMs": 300, "BreakAfterFailures": 5, "BreakDurationSeconds": 30, "SamplingSeconds": 30 }
  },
  "StaticMapTiles": {
    "BaseUrl": "https://tile.openstreetmap.org/",
    "TimeoutSeconds": 10,
    "UserAgent": "Nimbus/1.0 (flight preparation)",
    "Resilience": { "MaxRetries": 2, "RetryBaseDelayMs": 300, "BreakAfterFailures": 5, "BreakDurationSeconds": 30, "SamplingSeconds": 30 }
  },
  "Storage": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "UseHttps": true,
    "PresignedUrlExpiry": "00:15:00",
    "MaxRetryAttempts": 3,
    "Buckets": {
      "FlightImages": "flight-images",
      "FlightTracks": "flight-tracks",
      "FlightExports": "flight-exports",
      "MapCache": "map-cache"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nimbus-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 20971520,
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
