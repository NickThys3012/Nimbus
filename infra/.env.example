# Copy to /opt/nimbus/.env on the host and fill in. Never commit the filled version.

NIMBUS_DOMAIN=
ACME_EMAIL=
ASPNETCORE_ENVIRONMENT=Production
IMAGE_TAG=latest

MSSQL_SA_PASSWORD=
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=1792

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Dedicated application key — generated separately from the root pair above,
# scoped by minio-init.sh to only flight-images/flight-tracks/flight-exports/map-cache,
# no admin rights. This is what the API authenticates with, never MINIO_ROOT_*.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# Caddy basic-auth in front of the MinIO console (console.$NIMBUS_DOMAIN route).
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# IMPORTANT: Docker Compose interpolates ${VAR} references, and it will also treat
# literal `$` characters *inside* this value as (unset) variable references of its
# own, silently blanking out chunks of the hash. Escape every `$` as `$$` when you
# paste the hash into .env, e.g. `$2a$14$abc...` becomes `$$2a$$14$$abc...`.
# Verify after writing it: `docker compose config | grep MINIO_CONSOLE_PASSWORD_HASH`
# must show the same $$-escaped value, and
# `docker exec <caddy-container> sh -c 'echo $MINIO_CONSOLE_PASSWORD_HASH'` must
# show the original, un-escaped hash back.
MINIO_CONSOLE_USER=
MINIO_CONSOLE_PASSWORD_HASH=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ASP.NET Core env-var config binding requires double underscores as the
# section separator (Loki__Url -> configuration key "Loki:Url") — a single
# underscore here would silently leave Loki:Url empty and disable the sink.
Loki__Url=http://loki:3100

RESTIC_REPOSITORY=
RESTIC_PASSWORD=

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=